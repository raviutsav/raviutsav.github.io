---
import { siteConfig } from '../config/site';
import { resolvePath } from '../utils/url';

const PLACEHOLDER_USERNAME = 'YOUR_BUTTONDOWN_USERNAME';
const username = (siteConfig.buttondownUsername || '').trim();
const isConfigured = Boolean(username && username !== PLACEHOLDER_USERNAME);
const formAction = `https://buttondown.com/api/emails/embed-subscribe/${encodeURIComponent(
  isConfigured ? username : PLACEHOLDER_USERNAME
)}`;
---

<section class="newsletter-box" aria-labelledby="newsletter-heading">
  <h2 id="newsletter-heading" class="newsletter-title">
    New articles by email
  </h2>
  <p id="newsletter-description" class="newsletter-description">
    Get notified when a new article is published. No spam, unsubscribe anytime.
  </p>

  <form
    action={formAction}
    method="post"
    target="_blank"
    class="newsletter-form"
    data-newsletter-form
    data-configured={isConfigured ? 'true' : 'false'}
    novalidate
  >
    <label for="newsletter-email" class="sr-only">Email address</label>
    <input
      id="newsletter-email"
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      placeholder="you@example.com"
      required
      aria-describedby="newsletter-description newsletter-status"
      class="newsletter-input"
    />
    <input type="hidden" name="embed" value="1" />
    <button type="submit" class="newsletter-button">Subscribe</button>
  </form>

  <p
    id="newsletter-status"
    class="newsletter-status"
    role="status"
    aria-live="polite"
    hidden
  ></p>

  <p class="newsletter-rss-hint">
    Prefer a feed reader? <a href={resolvePath('/rss.xml')}>Subscribe via RSS</a>.
  </p>
</section>

<style>
  .newsletter-box {
    margin-top: 3.25rem;
    padding: 1.5rem 1.65rem;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    background-color: var(--bg-secondary);
  }

  .newsletter-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 0.45rem;
  }

  .newsletter-description {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 1.1rem;
  }

  .newsletter-form {
    display: flex;
    gap: 0.65rem;
    align-items: stretch;
  }

  .newsletter-input {
    flex: 1;
    min-width: 0;
    padding: 0.62rem 0.85rem;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--text-primary);
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 5px;
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .newsletter-input::placeholder {
    color: var(--text-muted);
  }

  .newsletter-input:focus {
    border-color: var(--accent);
  }

  .newsletter-input[aria-invalid='true'] {
    border-color: var(--accent);
  }

  .newsletter-button {
    padding: 0.62rem 1.15rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    color: #faf9f5;
    background-color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 5px;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .newsletter-button:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .newsletter-status {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0.75rem 0 0;
    color: var(--text-secondary);
  }

  .newsletter-status[data-state='error'] {
    color: var(--accent);
  }

  .newsletter-status[data-state='success'] {
    color: var(--text-primary);
  }

  .newsletter-rss-hint {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    margin: 0.85rem 0 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 520px) {
    .newsletter-box {
      padding: 1.25rem 1.15rem;
    }

    .newsletter-form {
      flex-direction: column;
    }

    .newsletter-button {
      width: 100%;
    }
  }
</style>

<script is:inline>
  function setupNewsletterForms() {
    const forms = document.querySelectorAll('[data-newsletter-form]');

    forms.forEach((form) => {
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      const emailInput = form.querySelector('input[type="email"]');
      const statusEl = form.parentElement?.querySelector('#newsletter-status');
      const isConfigured = form.dataset.configured === 'true';

      function showStatus(message, state) {
        if (!statusEl) return;
        statusEl.textContent = message;
        statusEl.dataset.state = state;
        statusEl.hidden = false;
      }

      if (emailInput) {
        emailInput.addEventListener('input', () => {
          emailInput.removeAttribute('aria-invalid');
          if (statusEl && statusEl.dataset.state === 'error') {
            statusEl.hidden = true;
          }
        });
      }

      form.addEventListener('submit', (event) => {
        if (!emailInput) return;

        const emailValue = emailInput.value.trim();
        emailInput.value = emailValue;

        if (!emailValue || !emailInput.checkValidity()) {
          event.preventDefault();
          emailInput.setAttribute('aria-invalid', 'true');
          emailInput.focus();
          showStatus('Please enter a valid email address.', 'error');
          return;
        }

        if (!isConfigured) {
          event.preventDefault();
          showStatus(
            'Newsletter signups are not enabled yet. Set your Buttondown username to activate subscriptions.',
            'error'
          );
          return;
        }

        emailInput.removeAttribute('aria-invalid');
        showStatus(
          'Opening Buttondown in a new tab to complete your subscription. Please check your inbox to confirm.',
          'success'
        );

        // Allow native form POST to Buttondown's hosted endpoint, then clear input.
        setTimeout(() => {
          emailInput.value = '';
        }, 0);
      });
    });
  }

  setupNewsletterForms();
  document.addEventListener('astro:after-swap', setupNewsletterForms);
</script>

