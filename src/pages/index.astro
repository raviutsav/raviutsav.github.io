---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { calculateReadingTime } from "../utils/readingTime";
import { resolvePath } from "../utils/url";
import { siteConfig } from "../config/site";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);

const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Show recent articles on the homepage
const recentPosts = sortedPosts.slice(0, 5);
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <div class="container content-column">
    <!-- Understated personal introduction -->
    <section style="margin-bottom: 3.5rem;">
      <h1
        style="font-size: 2.25rem; font-weight: 600; line-height: 1.25; margin-bottom: 1.25rem; letter-spacing: -0.02em;"
      >
        Thoughts on software, systems, and the art of figuring things out.
      </h1>

      <p
        style="font-size: 1.15rem; line-height: 1.7; color: var(--text-secondary); margin-bottom: 1.25rem;"
      >
        Welcome to my little corner of the internet. I write about software
        engineering, ideas worth exploring, and experiences that shape how I see
        the world. <br />
        <br /> No noise, no algorithms. Just things I learn, think about, and find
        worth sharing.
      </p>

      <div
        style="display: flex; gap: 1rem; align-items: center; margin-top: 1.5rem; font-size: 0.95rem;"
      >
        <a href={resolvePath("/writing")} style="font-weight: 500;">
          Browse all writing &rarr;
        </a>
        <span style="color: var(--border-color);">|</span>
        <a
          href={resolvePath("/about")}
          style="color: var(--text-muted); text-decoration: none;"
        >
          About me &rarr;
        </a>
      </div>
    </section>

    <hr />

    <!-- Recent Writing Section -->
    <section>
      <div
        style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.5rem;"
      >
        <h2 style="font-size: 1.35rem; font-weight: 600; margin: 0;">
          Recent Writing
        </h2>
        {
          sortedPosts.length > 5 && (
            <a
              href={resolvePath("/writing")}
              style="font-size: 0.88rem; font-family: var(--font-sans);"
            >
              View all ({sortedPosts.length}) &rarr;
            </a>
          )
        }
      </div>

      <div class="article-list">
        {
          recentPosts.map((post) => {
            const readingTime = calculateReadingTime(post.body);
            return (
              <ArticleCard
                slug={post.id}
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                readingTime={readingTime}
                tags={post.data.tags}
              />
            );
          })
        }
      </div>

      {
        sortedPosts.length > 5 && (
          <div style="margin-top: 2.5rem; text-align: center;">
            <a
              href={resolvePath("/writing")}
              style="display: inline-block; padding: 0.65rem 1.4rem; border: 1px solid var(--border-color); border-radius: 6px; text-decoration: none; font-size: 0.92rem; font-weight: 500; color: var(--text-primary); background-color: var(--bg-secondary); transition: all var(--transition-fast);"
            >
              Explore all articles &rarr;
            </a>
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>
