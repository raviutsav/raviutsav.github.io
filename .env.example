# ==============================================================================
# Environment Configuration (Optional)
# ==============================================================================

# Canonical site URL (used for Open Graph tags, canonical links, and RSS feeds)
SITE_URL=https://raviutsav.github.io

# Base path for deployment (e.g. '/' for root domain or '/personalpage/' for GitHub Pages project site)
BASE_PATH=/

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Leave blank or omit to run without any tracking scripts or cookies.
PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML meta tag verification token (optional)
# Copy only the `content="..."` value from Google Search Console.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Buttondown newsletter username (optional; e.g. raviutsav)
PUBLIC_BUTTONDOWN_USERNAME=
