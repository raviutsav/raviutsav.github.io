---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: Date;
  articleModifiedDate?: Date;
  articleTags?: string[];
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  articleDate,
  articleModifiedDate,
  articleTags,
  noindex,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      articleDate={articleDate}
      articleModifiedDate={articleModifiedDate}
      articleTags={articleTags}
      noindex={noindex}
    />
  </head>
  <body>
    <Header />
    <main id="main-content" style="flex: 1; padding: 3rem 0 4.5rem;">
      <slot />
    </main>
    <Footer />
  </body>
</html>
