---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: Date;
}

const { title, description, image, articleDate } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} articleDate={articleDate} />
  </head>
  <body>
    <Header />
    <main id="main-content" style="flex: 1; padding: 3rem 0 4.5rem;">
      <slot />
    </main>
    <Footer />
  </body>
</html>
